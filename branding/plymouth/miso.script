# Tema Plymouth de MiSO Desktop

Plymouth.SetBackgroundTopColor(0.043, 0.071, 0.125);
Plymouth.SetBackgroundBottomColor(0.016, 0.031, 0.063);

logo_image = Image("logo.png");
logo_sprite = Sprite(logo_image);

fun center_logo() {
    logo_sprite.SetX((Window.GetWidth() - logo_image.GetWidth()) / 2);
    logo_sprite.SetY((Window.GetHeight() - logo_image.GetHeight()) / 2);
}

center_logo();
Plymouth.SetRefreshFunction(center_logo);
